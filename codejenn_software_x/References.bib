@incollection{yan_proposal_2016,
	address = {Cham},
	title = {A {Proposal} to {OpenMP} for {Addressing} the {CPU} {Oversubscription} {Challenge}},
	volume = {9903},
	isbn = {978-3-319-45549-5 978-3-319-45550-1},
	url = {http://link.springer.com/10.1007/978-3-319-45550-1_14},
	doi = {10.1007/978-3-319-45550-1_14},
	abstract = {OpenMP has become a successful programming model for developing multi-threaded applications. However, there are still some challenges in terms of OpenMP’s interoperability within itself and with other parallel programming APIs. In this paper, we explore typical use cases that expose OpenMP’s interoperability challenges and report our proposed solutions for addressing the resource oversubscription issue as the eﬀorts by the OpenMP Interoperability language subcommittee. The solutions include OpenMP runtime routines for changing the wait policies, which include ACTIVE(SPIN BUSY or SPIN PAUSE), PASSIVE (SPIN YIELD or SUSPEND), of idling threads for improved resource management, and routines for supporting contributing OpenMP threads to other thread libraries or tasks. Our initial implementations are being done by extending two OpenMP runtime libraries, Intel OpenMP (IOMP) and GNU OpenMP (GOMP). The evaluation results demonstrate the eﬀectiveness of the proposed approach to address the CPU oversubscription challenge and detailed analysis provide heuristics for selecting an optimal wait policy according to the oversubscription ratios.},
	language = {en},
	urldate = {2025-10-15},
	booktitle = {{OpenMP}: {Memory}, {Devices}, and {Tasks}},
	publisher = {Springer International Publishing},
	author = {Yan, Yonghong and Hammond, Jeff R. and Liao, Chunhua and Eichenberger, Alexandre E.},
	editor = {Maruyama, Naoya and De Supinski, Bronis R. and Wahib, Mohamed},
	year = {2016},
	pages = {187--202},
}

